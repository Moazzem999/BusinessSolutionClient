@{
    ViewData["Title"] = "Create SO";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4 flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
    <div>
        <h1 class="page-title d-flex align-items-center gap-2">
            <i class="bi bi-cart-plus-fill text-primary"></i> Create SO
        </h1>
        <p class="page-subtitle mb-0">Create and process new purchase orders.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-controller="Order" asp-action="SupplierOrders" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-medium d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-receipt"></i>
            <span>Supplier Orders</span>
        </a>
    </div>
</div>

<!-- Empty Page Container / Starter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #ffffff;">
    <div class="card-body p-4 p-md-5 text-center">
        <div class="py-5">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-cart-plus fs-1"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Create SO</h4>
            <p class="text-muted mb-0 mx-auto" style="max-width: 480px;">
                This page is ready for your Purchase Order creation form and workflow.
            </p>
        </div>
    </div>
</div>
