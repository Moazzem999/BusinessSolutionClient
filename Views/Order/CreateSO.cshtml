@{
    ViewData["Title"] = "Create Supplier Order";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4 flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
    <div>
        <h1 class="page-title d-flex align-items-center gap-2">
            <i class="bi bi-cart-plus-fill text-primary"></i> Create Supplier Order
        </h1>
        <p class="page-subtitle mb-0">Create and submit a purchase order with itemized lines and real-time balance calculations.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-controller="Order" asp-action="SupplierOrders" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-medium d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Orders</span>
        </a>
    </div>
</div>

<!-- Alert Boxes -->
<div id="create-error-alert" class="alert alert-danger d-none rounded-3 mb-4 shadow-sm align-items-center gap-2" role="alert">
    <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
    <span id="create-error-message">Error submitting supplier order.</span>
    <button type="button" class="btn-close ms-auto" aria-label="Close" onclick="document.getElementById('create-error-alert').classList.add('d-none');"></button>
</div>

<div id="create-success-alert" class="alert alert-success d-none rounded-3 mb-4 shadow-sm align-items-center gap-2" role="alert">
    <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
    <span id="create-success-message">Supplier order created successfully! Redirecting...</span>
</div>

<!-- Main Form: Full-Width Spacious Layout -->
<form id="create-so-form" autocomplete="off">
    <!-- 1. Supplier & Order Info Card (Full Width) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #ffffff;">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle fw-bold" style="width: 26px; height: 26px; font-size: 0.8rem;">1</span>
                <h5 class="card-title fw-bold text-dark mb-0 fs-6">Supplier & Order Information</h5>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-3 align-items-start">
                <!-- Supplier Searchable Combobox -->
                <div class="col-12 col-lg-6 position-relative" id="supplier-search-container">
                    <label for="supplier-search-input" class="form-label text-dark small fw-semibold">
                        Search Supplier <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                            <i class="bi bi-person-search"></i>
                        </span>
                        <input type="text" 
                               id="supplier-search-input" 
                               class="form-control bg-light border-start-0 ps-1" 
                               placeholder="Type supplier name (min 3 chars to search, e.g. 'abdul')..." 
                               autocomplete="off" 
                               required>
                        <input type="hidden" id="supplier-id" name="supplierId">
                        <input type="hidden" id="supplier-previous-balance" name="supplierPreviousBalance" value="0">
                        <button type="button" 
                                id="btn-clear-supplier" 
                                class="btn btn-light border border-start-0 text-muted d-none" 
                                title="Clear Supplier Selection">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </div>

                    <!-- Autocomplete Suggestions Menu -->
                    <div id="supplier-suggestions-menu" 
                         class="position-absolute start-0 w-100 shadow-lg border border-secondary-subtle rounded-3 p-0 mt-1 overflow-auto bg-white d-none" 
                         style="max-height: 280px; z-index: 1060; top: 100%;">
                        <div id="supplier-suggestions-list" class="list-group list-group-flush small">
                            <!-- Dynamic suggestions -->
                        </div>
                    </div>
                </div>

                <!-- Order Date -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="order-date" class="form-label text-dark small fw-semibold">
                        Order Date <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted">
                            <i class="bi bi-calendar-event"></i>
                        </span>
                        <input type="date" class="form-control rounded-end" id="order-date" name="orderDate" required>
                    </div>
                </div>

                <!-- Notes / Remarks -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="order-notes" class="form-label text-dark small fw-semibold">
                        Order Notes / Remarks
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted">
                            <i class="bi bi-chat-text"></i>
                        </span>
                        <input type="text" class="form-control rounded-end" id="order-notes" name="notes" placeholder="e.g. Urgent shipment, notes">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Order Items & Products Card (Full Width - Maximum Space) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #ffffff;">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle fw-bold" style="width: 26px; height: 26px; font-size: 0.8rem;">2</span>
                <h5 class="card-title fw-bold text-dark mb-0 fs-6">Order Items & Products</h5>
                <span class="badge bg-light text-secondary border ms-2" id="items-count-text">1 item</span>
            </div>
            <button type="button" id="btn-add-item" class="btn btn-primary btn-sm rounded-3 px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-sm">
                <i class="bi bi-plus-lg"></i>
                <span>Add Item</span>
            </button>
        </div>
<style>
    .item-row {
        position: relative;
    }
    .product-search-container.active-dropdown {
        z-index: 1070;
    }

    /* Remove spinner arrows from Qty and Price number inputs */
    .item-quantity::-webkit-outer-spin-button,
    .item-quantity::-webkit-inner-spin-button,
    .item-unit-price::-webkit-outer-spin-button,
    .item-unit-price::-webkit-inner-spin-button,
    input.no-spinner::-webkit-outer-spin-button,
    input.no-spinner::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .item-quantity,
    .item-unit-price,
    input.no-spinner {
        -moz-appearance: textfield;
        appearance: textfield;
        overflow: hidden;
    }

    /* Prevent scrolling or wrapping on Qty and Price table columns */
    #order-items-table th:nth-child(4),
    #order-items-table td:nth-child(4),
    #order-items-table th:nth-child(5),
    #order-items-table td:nth-child(5) {
        white-space: nowrap;
        overflow: hidden;
    }
</style>

        <div class="card-body p-0">
            <div class="table-responsive" style="min-height: 280px; overflow-x: auto; overflow-y: visible;">
                <table class="table table-hover align-middle mb-0" id="order-items-table">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 text-secondary small fw-semibold text-uppercase" style="width: 45px;">#</th>
                            <th class="text-secondary small fw-semibold text-uppercase" style="min-width: 260px; width: 32%;">Product <span class="text-danger">*</span></th>
                            <th class="text-secondary small fw-semibold text-uppercase" style="min-width: 200px; width: 25%;">Remarks</th>
                            <th class="text-secondary small fw-semibold text-uppercase text-center" style="width: 120px;">Qty<span class="text-danger">*</span></th>
                            <th class="text-secondary small fw-semibold text-uppercase text-end" style="width: 150px;">Price<span class="text-danger">*</span></th>
                            <th class="text-secondary small fw-semibold text-uppercase text-end" style="width: 160px;">Total</th>
                            <th class="pe-4 text-secondary small fw-semibold text-uppercase text-center" style="width: 50px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="order-items-body">
                        <!-- Dynamic item rows injected by createSO.js -->
                    </tbody>
                </table>
            </div>
            <div class="p-3 bg-light bg-opacity-50 border-top d-flex align-items-center justify-content-between">
                <button type="button" id="btn-add-item-bottom" class="btn btn-outline-primary btn-sm rounded-3 px-3 fw-medium d-inline-flex align-items-center gap-1.5">
                    <i class="bi bi-plus-circle"></i>
                    <span>Add Another Item</span>
                </button>
            </div>
        </div>
    </div>

    <!-- 3. Financial Summary & Submit Bar (Simple, Horizontal & Compact) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #ffffff;">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                <!-- Simple Inline Financial Breakdown -->
                <div class="d-flex align-items-center flex-wrap gap-2 gap-md-3">
                    <div class="p-2 px-3 rounded-3 bg-light border">
                        <span class="text-muted small me-2">Previous Balance:</span>
                        <span class="fw-semibold text-dark" id="summary-prev-balance">৳ 0.00</span>
                    </div>

                    <span class="text-muted fw-bold fs-5 d-none d-sm-inline">+</span>

                    <div class="p-2 px-3 rounded-3 bg-primary bg-opacity-10 border border-primary-subtle">
                        <span class="text-primary small me-2 fw-medium">Order Total:</span>
                        <span class="fw-bold text-primary fs-6" id="summary-order-total">৳ 0.00</span>
                    </div>

                    <span class="text-muted fw-bold fs-5 d-none d-sm-inline">=</span>

                    <div class="p-2 px-3 rounded-3 bg-success-subtle border border-success-subtle">
                        <span class="text-success small me-2 fw-medium">New Balance:</span>
                        <span class="fw-bold text-success fs-6" id="summary-new-balance">৳ 0.00</span>
                    </div>
                </div>

                <!-- Form Action Buttons -->
                <div class="d-flex align-items-center gap-2 justify-content-end">
                    <a asp-controller="Order" asp-action="SupplierOrders" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-medium">
                        Cancel
                    </a>
                    <button type="submit" id="btn-submit-order" class="btn btn-primary rounded-3 px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm">
                        <span id="btn-spinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        <i class="bi bi-check2-circle fs-5" id="btn-icon"></i>
                        <span id="btn-text">Create Order</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const API_BASE_URL = "@apiBaseUrl";
    </script>
    <script src="~/js/Order/createSO.js" asp-append-version="true"></script>
}
