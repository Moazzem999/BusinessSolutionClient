@{
    ViewData["Title"] = "Dashboard Overview";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4">
    <div>
        <h1 class="page-title">Analytics Dashboard</h1>
    </div>
    <div>
        <button type="button" id="btn-refresh-dashboard" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" title="Refresh live analytics">
            <i class="bi bi-arrow-clockwise" id="refresh-icon"></i>
            <span>Refresh</span>
        </button>
    </div>
</div>

<!-- Today's Financial & Sales Performance -->
<div class="mb-4">
    <h6 class="text-uppercase text-muted fw-bold small mb-3 d-flex align-items-center gap-2" style="letter-spacing: 0.05em;">
        <i class="bi bi-calendar-check text-primary"></i> Today's Performance
    </h6>
    <div class="metrics-grid mb-0">
        <!-- Total Sales Today -->
        <a asp-controller="Order" asp-action="CustomerOrders" class="metric-card" title="View customer orders">
            <div class="metric-icon-box metric-icon-blue">
                <i class="bi bi-cart-check-fill"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Total Sales<br>(Today)</div>
                <div class="metric-value">
                    <span class="fs-5 fw-normal text-secondary me-1">৳</span><span id="metric-sales-today">0.00</span>
                </div>
            </div>
        </a>

        <!-- Total Payment Received Today -->
        <a asp-controller="Customer" asp-action="TransactionLog" class="metric-card" title="View customer transactions">
            <div class="metric-icon-box metric-icon-green">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Payment Received<br>(Today)</div>
                <div class="metric-value">
                    <span class="fs-5 fw-normal text-secondary me-1">৳</span><span id="metric-payment-today">0.00</span>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Customer Analytics -->
<div class="mb-4">
    <h6 class="text-uppercase text-muted fw-bold small mb-3 d-flex align-items-center gap-2" style="letter-spacing: 0.05em;">
        <i class="bi bi-people-fill text-primary"></i> Customer Analytics
    </h6>
    <div class="metrics-grid mb-0">
        <!-- Total Customers Card -->
        <a asp-controller="Customer" asp-action="List" class="metric-card" title="View all customers">
            <div class="metric-icon-box metric-icon-indigo">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Total<br>Customers</div>
                <div class="metric-value" id="metric-total-customers">0</div>
            </div>
        </a>

        <!-- Special Customers Card -->
        <a asp-controller="Customer" asp-action="List" asp-route-isSpecial="true" class="metric-card" title="View special customers">
            <div class="metric-icon-box metric-icon-purple">
                <i class="bi bi-star-fill"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Special<br>Customers</div>
                <div class="metric-value" id="metric-special-customers">0</div>
            </div>
        </a>

        <!-- Regular Customers Card -->
        <a asp-controller="Customer" asp-action="List" asp-route-isSpecial="false" class="metric-card" title="View regular customers">
            <div class="metric-icon-box metric-icon-cyan">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Regular<br>Customers</div>
                <div class="metric-value" id="metric-regular-customers">0</div>
            </div>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = "@apiBaseUrl";
    </script>
    <script src="~/js/Dashboard/dashboard.js" asp-append-version="true"></script>
}
