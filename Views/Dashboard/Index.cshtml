@{
    ViewData["Title"] = "Dashboard Overview";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4">
    <div>
        <h1 class="page-title d-flex align-items-center gap-2">
            <i class="bi bi-grid-fill text-primary"></i> Analytics Dashboard
        </h1>
        <p class="page-subtitle text-muted mb-0">Real-time daily & monthly business performance and customer analytics.</p>
    </div>
    <div>
        <button type="button" id="btn-refresh-dashboard" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" title="Refresh live analytics">
            <i class="bi bi-arrow-clockwise" id="refresh-icon"></i>
            <span>Refresh</span>
        </button>
    </div>
</div>

<!-- Sales & Revenue Performance (Today & This Month) -->
<div class="mb-4">
    <h6 class="text-uppercase text-muted fw-bold small mb-3 d-flex align-items-center gap-2" style="letter-spacing: 0.05em;">
        <i class="bi bi-cash-coin text-primary"></i> Sales & Payment Performance
    </h6>
    <div class="metrics-grid mb-0">
        <!-- Total Sales Today -->
        <a asp-controller="Order" asp-action="CustomerOrders" class="metric-card" title="View customer orders">
            <div class="metric-icon-box metric-icon-blue">
                <i class="bi bi-cart-check-fill"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Total Sales<br>(Today)</div>
                <div class="metric-value">
                    <span class="fs-5 fw-normal text-secondary me-1">৳</span><span id="metric-sales-today">0.00</span>
                </div>
            </div>
        </a>

        <!-- Total Sales This Month -->
        <a asp-controller="Order" asp-action="CustomerOrders" class="metric-card" title="View monthly customer orders">
            <div class="metric-icon-box metric-icon-indigo">
                <i class="bi bi-graph-up-arrow"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Total Sales<br>(This Month)</div>
                <div class="metric-value">
                    <span class="fs-5 fw-normal text-secondary me-1">৳</span><span id="metric-sales-month">0.00</span>
                </div>
            </div>
        </a>

        <!-- Total Payment Received Today -->
        <a asp-controller="Customer" asp-action="TransactionLog" class="metric-card" title="View today's transactions">
            <div class="metric-icon-box metric-icon-green">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Payment Received<br>(Today)</div>
                <div class="metric-value">
                    <span class="fs-5 fw-normal text-secondary me-1">৳</span><span id="metric-payment-today">0.00</span>
                </div>
            </div>
        </a>

        <!-- Total Payment Received This Month -->
        <a asp-controller="Customer" asp-action="TransactionLog" class="metric-card" title="View monthly transactions">
            <div class="metric-icon-box metric-icon-cyan">
                <i class="bi bi-wallet2"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Payment Received<br>(This Month)</div>
                <div class="metric-value">
                    <span class="fs-5 fw-normal text-secondary me-1">৳</span><span id="metric-payment-month">0.00</span>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Monthly Sales & Payment Trend Analysis (Day-wise Breakdown) -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background: #ffffff; border: 1px solid var(--border-color) !important;">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-bar-chart-line-fill text-primary"></i> Monthly Sales & Payment Trends
            </h5>
            <p class="text-muted small mb-0">Day-by-day comparison of sales revenue and payment collections for this month</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background-color: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe;">
                <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> Total Sales: <strong id="badge-month-sales">৳ 0.00</strong>
            </span>
            <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background-color: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0;">
                <i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> Collections: <strong id="badge-month-payment">৳ 0.00</strong>
            </span>
            <div class="btn-group btn-group-sm rounded-3 shadow-none border" role="group" aria-label="Chart view type">
                <button type="button" class="btn btn-light active fw-semibold" id="btn-chart-bar" title="Bar Chart View">
                    <i class="bi bi-bar-chart-fill me-1"></i> Bar
                </button>
                <button type="button" class="btn btn-light fw-semibold" id="btn-chart-line" title="Line Chart View">
                    <i class="bi bi-graph-up me-1"></i> Line
                </button>
                <button type="button" class="btn btn-light fw-semibold" id="btn-view-table" title="Table View">
                    <i class="bi bi-table me-1"></i> Table
                </button>
            </div>
        </div>
    </div>

    <!-- Chart Container -->
    <div id="chart-view-container" style="position: relative; height: 320px; width: 100%;">
        <canvas id="monthlyTrendsChart"></canvas>
    </div>

    <!-- Table View Container (hidden by default) -->
    <div id="table-view-container" class="d-none table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr class="small text-muted text-uppercase">
                    <th scope="col" class="ps-3">Day / Date</th>
                    <th scope="col" class="text-end">Sales (৳)</th>
                    <th scope="col" class="text-end">Payment Received (৳)</th>
                    <th scope="col" class="text-end pe-3">Net Difference</th>
                </tr>
            </thead>
            <tbody id="month-data-table-body">
                <tr>
                    <td colspan="4" class="text-center py-4 text-muted">
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>Loading day-wise records...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Customer Analytics -->
<div class="mb-4">
    <h6 class="text-uppercase text-muted fw-bold small mb-3 d-flex align-items-center gap-2" style="letter-spacing: 0.05em;">
        <i class="bi bi-people-fill text-primary"></i> Customer Analytics
    </h6>
    <div class="metrics-grid mb-0">
        <!-- Total Customers Card -->
        <a asp-controller="Customer" asp-action="List" class="metric-card" title="View all customers">
            <div class="metric-icon-box metric-icon-indigo">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Total<br>Customers</div>
                <div class="metric-value" id="metric-total-customers">0</div>
            </div>
        </a>

        <!-- Special Customers Card -->
        <a asp-controller="Customer" asp-action="List" asp-route-isSpecial="true" class="metric-card" title="View special customers">
            <div class="metric-icon-box metric-icon-purple">
                <i class="bi bi-star-fill"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Special<br>Customers</div>
                <div class="metric-value" id="metric-special-customers">0</div>
            </div>
        </a>

        <!-- Regular Customers Card -->
        <a asp-controller="Customer" asp-action="List" asp-route-isSpecial="false" class="metric-card" title="View regular customers">
            <div class="metric-icon-box metric-icon-cyan">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div class="metric-info">
                <div class="metric-label">Regular<br>Customers</div>
                <div class="metric-value" id="metric-regular-customers">0</div>
            </div>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = "@apiBaseUrl";
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/Dashboard/dashboard.js" asp-append-version="true"></script>
}
