@{
    ViewData["Title"] = "Employee Advance Payments";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4 flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
    <div>
        <h1 class="page-title">Employee Advance Payments</h1>
        <p class="page-subtitle mb-0">View, search, and manage advance payment requests and records for employees.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" id="btn-export-pdf" class="btn btn-outline-danger rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-file-earmark-pdf-fill fs-6 text-danger"></i>
            <span>Download PDF</span>
        </button>
        <button type="button" id="btn-export-excel" class="btn btn-outline-success rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-file-earmark-excel-fill fs-6 text-success"></i>
            <span>Download Excel</span>
        </button>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #ffffff;">
    <div class="card-body p-3 p-md-4">
        <form id="advance-payment-search-form" class="row g-2 g-md-3 align-items-end">
            <!-- Search Text -->
            <div class="col-12 col-md-3">
                <label for="search-input" class="form-label text-muted small fw-medium mb-1">Search Term</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="search-input" class="form-control bg-light border-start-0 ps-1" placeholder="Search by description, name..." autocomplete="off">
                </div>
            </div>

            <!-- Employee Dropdown Filter -->
            <div class="col-12 col-sm-6 col-md-3">
                <label for="employee-select" class="form-label text-muted small fw-medium mb-1">Filter by Employee</label>
                <select id="employee-select" class="form-select bg-light rounded-3">
                    <option value="">All Employees</option>
                </select>
            </div>

            <!-- From Date Filter -->
            <div class="col-6 col-sm-3 col-md-2">
                <label for="from-date-input" class="form-label text-muted small fw-medium mb-1">From Date</label>
                <input type="date" id="from-date-input" class="form-control bg-light rounded-3">
            </div>

            <!-- To Date Filter -->
            <div class="col-6 col-sm-3 col-md-2">
                <label for="to-date-input" class="form-label text-muted small fw-medium mb-1">To Date</label>
                <input type="date" id="to-date-input" class="form-control bg-light rounded-3">
            </div>

            <!-- Action Buttons -->
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" id="btn-search" class="btn btn-primary flex-fill rounded-3 px-3 fw-medium d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-filter"></i> Search
                </button>
                <button type="button" id="btn-reset" class="btn btn-outline-secondary rounded-3 px-3 fw-medium d-inline-flex align-items-center justify-content-center" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>

            <!-- Page Size Selector -->
            <div class="col-12 d-flex align-items-center justify-content-end gap-2 mt-2 pt-2 border-top">
                <label for="page-size-select" class="form-label text-muted small mb-0 fw-medium">Rows per page:</label>
                <select id="page-size-select" class="form-select form-select-sm rounded-3" style="width: 75px;">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </form>
    </div>
</div>

<!-- Alert Box for API connection errors -->
<div id="api-error-alert" class="alert alert-danger d-none rounded-3 mb-4 shadow-sm align-items-center gap-2" role="alert">
    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
    <span id="api-error-message">Failed to connect to backend server.</span>
</div>

<!-- Advance Payment Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: #ffffff;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 advance-payment-table">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;"># ID</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Employee</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Amount</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Payment Date</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Description</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Status</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Created On</th>
                    <th class="pe-4 text-end text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Action</th>
                </tr>
            </thead>
            <tbody id="payment-table-body">
                <!-- Loading Skeleton -->
                <tr id="payment-loading-row">
                    <td colspan="8" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="text-muted small mt-2">Fetching advance payments list...</div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Empty State Container -->
    <div id="payment-empty-state" class="text-center py-5 d-none">
        <div class="mb-3 text-muted" style="font-size: 3rem;">
            <i class="bi bi-cash-coin"></i>
        </div>
        <h5 class="fw-semibold text-dark mb-1">No Advance Payments Found</h5>
        <p class="text-muted small mb-0">Try adjusting your search criteria or clear date/employee filters.</p>
    </div>

    <!-- Table Footer / Pagination -->
    <div class="card-footer bg-white border-top-0 p-3 p-md-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
        <div id="pagination-info" class="text-muted small">
            Showing 0 to 0 of 0 entries
        </div>
        <nav aria-label="Advance Payment List Pagination">
            <ul id="pagination-list" class="pagination pagination-sm mb-0 gap-1">
                <!-- Dynamic Pagination Buttons -->
            </ul>
        </nav>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="advancePaymentDetailsModal" tabindex="-1" aria-labelledby="advancePaymentDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="advancePaymentDetailsModalLabel">
                    <i class="bi bi-cash-stack text-primary"></i> Advance Payment Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modal-payment-content">
                <!-- Dynamic Modal Content -->
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    <div id="app-toast" class="toast align-items-center text-white border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 py-3 px-3 fs-6">
                <i id="toast-icon" class="bi fs-5"></i>
                <span id="toast-message"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = "@apiBaseUrl";
    </script>
    <!-- jsPDF & AutoTable for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <!-- SheetJS for Excel Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="~/js/Employee/advancePayment.js" asp-append-version="true"></script>
}
