@{
    ViewData["Title"] = "Change Password";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4 flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
    <div>
        <h1 class="page-title d-flex align-items-center gap-2">
            <i class="bi bi-key-fill text-primary"></i> Change Password
        </h1>
        <p class="page-subtitle mb-0">Update your account password to ensure your account stays secure.</p>
    </div>
    <div>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-medium d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> Dashboard
        </a>
    </div>
</div>

<!-- Main Content Row -->
<div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8 col-xl-6">

        <!-- Form Alerts -->
        <div id="change-password-error-alert" class="alert alert-danger d-none rounded-3 py-2.5 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
            <span id="change-password-error-message"></span>
        </div>

        <div id="change-password-success-alert" class="alert alert-success d-none rounded-3 py-2.5 px-3 small d-flex align-items-center gap-2 mb-3 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
            <span id="change-password-success-message"></span>
        </div>

        <!-- Change Password Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-5" style="background: #ffffff;">
            <div class="card-body p-4 p-md-5">

                <!-- Header Banner Inside Card -->
                <div class="text-center mb-4 pb-2 border-bottom">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 58px; height: 58px;">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">Account Security</h4>
                    <p class="text-muted small mb-0">Enter your current password and choose a strong new password.</p>
                </div>

                <form id="change-password-form" novalidate>

                    <!-- Current Password -->
                    <div class="mb-3">
                        <label for="currentPassword" class="form-label text-dark small fw-semibold">
                            Current Password <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input type="password" 
                                   class="form-control border-start-0 border-end-0 bg-light" 
                                   id="currentPassword" 
                                   name="currentPassword" 
                                   placeholder="Enter current password" 
                                   autocomplete="current-password" 
                                   required />
                            <button type="button" 
                                    class="btn btn-light border border-start-0 text-secondary" 
                                    id="toggle-current-password" 
                                    tabindex="-1" 
                                    title="Show/Hide password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback d-none text-danger small mt-1" id="current-password-feedback">
                            Current password is required.
                        </div>
                    </div>

                    <!-- New Password -->
                    <div class="mb-3">
                        <label for="newPassword" class="form-label text-dark small fw-semibold">
                            New Password <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-key"></i>
                            </span>
                            <input type="password" 
                                   class="form-control border-start-0 border-end-0 bg-light" 
                                   id="newPassword" 
                                   name="newPassword" 
                                   placeholder="Enter new password" 
                                   autocomplete="new-password" 
                                   required />
                            <button type="button" 
                                    class="btn btn-light border border-start-0 text-secondary" 
                                    id="toggle-new-password" 
                                    tabindex="-1" 
                                    title="Show/Hide password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="form-text text-muted small mt-1" id="new-password-help">
                            <i class="bi bi-info-circle me-1"></i>Password must be at least 6 characters long.
                        </div>
                        <div class="invalid-feedback d-none text-danger small mt-1" id="new-password-feedback">
                            New password is required.
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-4">
                        <label for="confirmPassword" class="form-label text-dark small fw-semibold">
                            Confirm Password <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-check2-circle"></i>
                            </span>
                            <input type="password" 
                                   class="form-control border-start-0 border-end-0 bg-light" 
                                   id="confirmPassword" 
                                   name="confirmPassword" 
                                   placeholder="Re-enter new password" 
                                   autocomplete="new-password" 
                                   required />
                            <button type="button" 
                                    class="btn btn-light border border-start-0 text-secondary" 
                                    id="toggle-confirm-password" 
                                    tabindex="-1" 
                                    title="Show/Hide password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback d-none text-danger small mt-1" id="confirm-password-feedback">
                            Please confirm your new password.
                        </div>
                    </div>

                    <!-- Password Policy Info Box -->
                    <div class="p-3 bg-light rounded-3 mb-4 border">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-shield-check text-primary fs-5 mt-n1"></i>
                            <div class="small text-secondary">
                                <strong class="text-dark d-block mb-1">Security Notice:</strong>
                                Once your password is changed, your current session will immediately end and you will be redirected to the login page to sign in with your new credentials.
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center justify-content-end gap-2 pt-2">
                        <button type="submit" 
                                id="btn-submit-password" 
                                class="btn btn-primary rounded-3 px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                            <i class="bi bi-check2-circle" id="btn-submit-icon"></i>
                            <span id="btn-submit-text">Change Password</span>
                            <span class="spinner-border spinner-border-sm d-none" id="btn-submit-spinner" role="status" aria-hidden="true"></span>
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

<!-- Bootstrap Toast Notification Container (Top Right) -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;">
    <div id="app-toast" class="toast align-items-center text-white border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-start gap-2 py-3 px-3 fs-6">
                <i id="toast-icon" class="bi fs-5 mt-0.5 flex-shrink-0"></i>
                <span id="toast-message"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = '@apiBaseUrl';
    </script>
    <script src="~/js/Settings/changePassword.js" asp-append-version="true"></script>
}

