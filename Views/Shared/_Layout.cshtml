<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Business Solution (HRSync)</title>
    <!-- Latest Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function() {
            const savedTheme = localStorage.getItem('bs_app_theme');
            if (savedTheme) {
                document.documentElement.setAttribute('data-app-theme', savedTheme);
            }
        })();
    </script>
</head>
<body>

    <div class="app-layout">
        <!-- Sidebar Navigation matching sample design -->
        <aside class="app-sidebar">
            <div class="sidebar-brand">
                <span class="brand-text-hrs">Business</span>
                <span class="brand-text-sync">Solution</span>
            </div>

@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var isDashboardActive = currentController == "Dashboard";
    var isEmployeeActive = currentController == "Employee";
}

            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(isDashboardActive ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>

                <!-- Employees Group with Submenu -->
                <div class="sidebar-group">
                    <a href="#employeesSubmenu" class="sidebar-link d-flex align-items-center justify-content-between @(isEmployeeActive ? "active" : "")" data-bs-toggle="collapse" aria-expanded="@(isEmployeeActive ? "true" : "false")" role="button">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-people-fill"></i>
                            <span>Employees</span>
                        </div>
                        <i class="bi bi-chevron-down sidebar-chevron"></i>
                    </a>
                    <div class="collapse @(isEmployeeActive ? "show" : "")" id="employeesSubmenu">
                        <div class="sidebar-submenu">
                            <a asp-controller="Employee" asp-action="List" class="sidebar-sublink @(isEmployeeActive && currentAction == "List" ? "active" : "")">
                                <i class="bi bi-list-ul"></i>
                                <span>List</span>
                            </a>
                            <a asp-controller="Employee" asp-action="Create" class="sidebar-sublink @(isEmployeeActive && currentAction == "Create" ? "active" : "")">
                                <i class="bi bi-person-plus-fill"></i>
                                <span>Create</span>
                            </a>
                            <a asp-controller="Employee" asp-action="AdvancePayment" class="sidebar-sublink @(isEmployeeActive && currentAction == "AdvancePayment" ? "active" : "")">
                                <i class="bi bi-cash-stack"></i>
                                <span>Advance Payment</span>
                            </a>
                        </div>
                    </div>
                </div>

                <a href="#" class="sidebar-link">
                    <i class="bi bi-building"></i>
                    <span>Departments</span>
                </a>
                <a href="#" class="sidebar-link">
                    <i class="bi bi-currency-dollar"></i>
                    <span>Payroll</span>
                </a>
                <a href="#" class="sidebar-link">
                    <i class="bi bi-gear-fill"></i>
                    <span>Settings</span>
                </a>
            </nav>
        </aside>

        <!-- Main Wrapper -->
        <div class="app-main">
            
            <!-- Top Navbar matching sample design -->
            <header class="top-navbar">
                <button type="button" class="sidebar-toggle-btn" id="sidebar-toggle-btn" aria-label="Toggle Navigation">
                    <i class="bi bi-list"></i>
                </button>

                <div class="user-nav-actions ms-auto">
                    <!-- Navbar Theme Color Palette Dropdown -->
                    <div class="dropdown">
                        <button type="button" class="nav-icon-btn me-1" id="navbar-theme-dropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Navigation Theme Color">
                            <i class="bi bi-palette-fill"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-3" style="width: 260px; border-radius: 14px; margin-top: 0.5rem;" aria-labelledby="navbar-theme-dropdown">
                            <h6 class="dropdown-header px-0 text-uppercase fw-bold text-muted small mb-2">Navigation Theme</h6>
                            <div class="d-flex flex-column gap-2 app-color-picker">
                                <button type="button" class="btn btn-sm text-start d-flex align-items-center justify-content-between px-3 py-2 rounded-3 border-0 active-theme-btn" data-app-theme="default">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="color-dot border" style="background: linear-gradient(135deg, #ffffff 50%, #0b1329 50%);"></span>
                                        <span class="fw-medium">Classic Navy</span>
                                    </div>
                                    <i class="bi bi-check-lg theme-check-icon"></i>
                                </button>
                                <button type="button" class="btn btn-sm text-start d-flex align-items-center justify-content-between px-3 py-2 rounded-3 border-0" data-app-theme="dark">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="color-dot" style="background: linear-gradient(135deg, #18181b 50%, #090d16 50%);"></span>
                                        <span class="fw-medium">Dark Slate</span>
                                    </div>
                                    <i class="bi bi-check-lg theme-check-icon d-none"></i>
                                </button>
                                <button type="button" class="btn btn-sm text-start d-flex align-items-center justify-content-between px-3 py-2 rounded-3 border-0" data-app-theme="blue">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="color-dot" style="background: linear-gradient(135deg, #2563eb 50%, #1e3a8a 50%);"></span>
                                        <span class="fw-medium">Royal Blue</span>
                                    </div>
                                    <i class="bi bi-check-lg theme-check-icon d-none"></i>
                                </button>
                                <button type="button" class="btn btn-sm text-start d-flex align-items-center justify-content-between px-3 py-2 rounded-3 border-0" data-app-theme="emerald">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="color-dot" style="background: linear-gradient(135deg, #059669 50%, #064e3b 50%);"></span>
                                        <span class="fw-medium">Emerald Green</span>
                                    </div>
                                    <i class="bi bi-check-lg theme-check-icon d-none"></i>
                                </button>
                                <button type="button" class="btn btn-sm text-start d-flex align-items-center justify-content-between px-3 py-2 rounded-3 border-0" data-app-theme="purple">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="color-dot" style="background: linear-gradient(135deg, #7c3aed 50%, #4c1d95 50%);"></span>
                                        <span class="fw-medium">Deep Purple</span>
                                    </div>
                                    <i class="bi bi-check-lg theme-check-icon d-none"></i>
                                </button>
                                <button type="button" class="btn btn-sm text-start d-flex align-items-center justify-content-between px-3 py-2 rounded-3 border-0" data-app-theme="crimson">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="color-dot" style="background: linear-gradient(135deg, #be123c 50%, #881337 50%);"></span>
                                        <span class="fw-medium">Crimson Rose</span>
                                    </div>
                                    <i class="bi bi-check-lg theme-check-icon d-none"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <button type="button" class="nav-icon-btn" title="Notifications">
                        <i class="bi bi-bell"></i>
                    </button>
                    
                    <div class="dropdown">
                        <div class="avatar-circle" id="user-avatar-btn" data-bs-toggle="dropdown" aria-expanded="false">
                            AD
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="border-radius: 12px; margin-top: 0.5rem;">
                            <li><h6 class="dropdown-header" id="dropdown-user-name">Super Admin</h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger d-flex items-center gap-2" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Body -->
            <main class="page-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Mobile Sidebar Backdrop Overlay -->
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <!-- Latest Bootstrap 5.3 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
