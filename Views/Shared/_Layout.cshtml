<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Business Solution (HRSync)</title>
    <!-- Latest Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="app-layout">
        <!-- Sidebar Navigation matching sample design -->
        <aside class="app-sidebar">
            <div class="sidebar-brand">
                <span class="brand-text-hrs">Business</span>
                <span class="brand-text-sync">Solution</span>
            </div>

@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var isDashboardActive = currentController == "Dashboard";
    var isEmployeeActive = currentController == "Employee";
}

            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-link @(isDashboardActive ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>
                </a>

                <!-- Employees Group with Submenu -->
                <div class="sidebar-group">
                    <a href="#employeesSubmenu" class="sidebar-link d-flex align-items-center justify-content-between @(isEmployeeActive ? "active" : "")" data-bs-toggle="collapse" aria-expanded="@(isEmployeeActive ? "true" : "false")" role="button">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-people-fill"></i>
                            <span>Employees</span>
                        </div>
                        <i class="bi bi-chevron-down sidebar-chevron"></i>
                    </a>
                    <div class="collapse @(isEmployeeActive ? "show" : "")" id="employeesSubmenu">
                        <div class="sidebar-submenu">
                            <a asp-controller="Employee" asp-action="List" class="sidebar-sublink @(isEmployeeActive && currentAction == "List" ? "active" : "")">
                                <i class="bi bi-list-ul"></i>
                                <span>List</span>
                            </a>
                        </div>
                    </div>
                </div>

                <a href="#" class="sidebar-link">
                    <i class="bi bi-building"></i>
                    <span>Departments</span>
                </a>
                <a href="#" class="sidebar-link">
                    <i class="bi bi-currency-dollar"></i>
                    <span>Payroll</span>
                </a>
                <a href="#" class="sidebar-link">
                    <i class="bi bi-gear-fill"></i>
                    <span>Settings</span>
                </a>
            </nav>
        </aside>

        <!-- Main Wrapper -->
        <div class="app-main">
            
            <!-- Top Navbar matching sample design -->
            <header class="top-navbar">
                <button type="button" class="sidebar-toggle-btn" id="sidebar-toggle-btn" aria-label="Toggle Navigation">
                    <i class="bi bi-list"></i>
                </button>

                <div class="user-nav-actions ms-auto">
                    <button type="button" class="nav-icon-btn" title="Notifications">
                        <i class="bi bi-bell"></i>
                    </button>
                    
                    <div class="dropdown">
                        <div class="avatar-circle" id="user-avatar-btn" data-bs-toggle="dropdown" aria-expanded="false">
                            AD
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="border-radius: 12px; margin-top: 0.5rem;">
                            <li><h6 class="dropdown-header" id="dropdown-user-name">Super Admin</h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger d-flex items-center gap-2" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Body -->
            <main class="page-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Mobile Sidebar Backdrop Overlay -->
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

    <!-- Latest Bootstrap 5.3 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
