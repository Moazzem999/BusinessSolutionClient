@{
    ViewData["Title"] = "Supplier List";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4 flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
    <div>
        <h1 class="page-title d-flex align-items-center gap-2">
            <i class="bi bi-truck text-primary"></i> Supplier Management
        </h1>
        <p class="page-subtitle mb-0">View, search, filter, and manage all supplier records in your business.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-controller="Supplier" asp-action="Create" class="btn btn-primary rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle-fill fs-6"></i>
            <span>Create</span>
        </a>
        <button type="button" id="btn-export-pdf" class="btn btn-outline-danger rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-file-earmark-pdf-fill fs-6 text-danger"></i>
            <span>Download PDF</span>
        </button>
        <button type="button" id="btn-export-excel" class="btn btn-outline-success rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-file-earmark-excel-fill fs-6 text-success"></i>
            <span>Download Excel</span>
        </button>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #ffffff;">
    <div class="card-body p-3 p-md-4">
        <form id="supplier-search-form" class="row g-2 g-md-3 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="search-input" class="form-control bg-light border-start-0 ps-1" placeholder="Search by shop name, supplier name, mobile, email, NID..." autocomplete="off">
                </div>
            </div>
            <div class="col-6 col-md-auto">
                <button type="submit" id="btn-search" class="btn btn-primary w-100 rounded-3 px-3 fw-medium d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-filter"></i> Search
                </button>
            </div>
            <div class="col-6 col-md-auto">
                <button type="button" id="btn-reset" class="btn btn-outline-secondary w-100 rounded-3 px-3 fw-medium d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
            </div>
            <div class="col-12 col-md-auto ms-md-auto d-flex align-items-center justify-content-between justify-content-md-end gap-2 mt-2 mt-md-0">
                <label for="page-size-select" class="form-label text-muted small mb-0 fw-medium">Rows per page:</label>
                <select id="page-size-select" class="form-select form-select-sm rounded-3" style="width: 75px;">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </form>
    </div>
</div>

<!-- Alert Box for API connection errors -->
<div id="api-error-alert" class="alert alert-danger d-none rounded-3 mb-4 shadow-sm align-items-center gap-2" role="alert">
    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
    <span id="api-error-message">Failed to connect to backend server.</span>
</div>

<!-- Supplier Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: #ffffff;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 supplier-list-table">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Supplier & Shop</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Contact Info</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">NID No</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Current Balance</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Present Address</th>
                    <th class="pe-4 text-end text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Action</th>
                </tr>
            </thead>
            <tbody id="supplier-table-body">
                <!-- Loading Skeleton -->
                <tr id="supplier-loading-row">
                    <td colspan="6" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="text-muted small mt-2">Fetching suppliers list...</div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Empty State Container -->
    <div id="supplier-empty-state" class="text-center py-5 d-none">
        <div class="mb-3 text-muted" style="font-size: 3rem;">
            <i class="bi bi-shop-window"></i>
        </div>
        <h5 class="fw-semibold text-dark mb-1">No Suppliers Found</h5>
        <p class="text-muted small mb-0">Try changing your search query or clear filters.</p>
    </div>

    <!-- Table Footer / Pagination -->
    <div class="card-footer bg-white border-top-0 p-3 p-md-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
        <div id="pagination-info" class="text-muted small">
            Showing 0 to 0 of 0 entries
        </div>
        <nav aria-label="Supplier List Pagination">
            <ul id="pagination-list" class="pagination pagination-sm mb-0 gap-1">
                <!-- Dynamic Pagination Buttons -->
            </ul>
        </nav>
    </div>
</div>

<!-- Supplier Details Modal -->
<div class="modal fade" id="supplierDetailsModal" tabindex="-1" aria-labelledby="supplierDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="supplierDetailsModalLabel">
                    <i class="bi bi-building-fill text-primary"></i> Supplier Profile Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modal-supplier-content">
                <!-- Dynamic Modal Content -->
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Update Supplier Modal -->
<div class="modal fade" id="updateSupplierModal" tabindex="-1" aria-labelledby="updateSupplierModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="updateSupplierModalLabel">
                    <i class="bi bi-pencil-square text-primary"></i> Edit Supplier Information
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Alert Box inside modal for API errors -->
                <div id="update-error-alert" class="alert alert-danger d-none rounded-3 mb-4 shadow-sm align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span id="update-error-message">Error updating supplier data.</span>
                </div>

                <!-- Update Form matching Create Form structure -->
                <form id="update-supplier-form" enctype="multipart/form-data">
                    <input type="hidden" id="update-Id" name="Id" />

                    <!-- Section 1: Basic & Shop Information -->
                    <div class="mb-4 pb-3 border-bottom">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-shop"></i> Shop & Basic Information
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6 col-lg-4">
                                <label for="update-ShopName" class="form-label text-dark small fw-semibold">Shop Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control rounded-3" id="update-ShopName" name="ShopName" placeholder="e.g. Acme Traders" required>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <label for="update-Name" class="form-label text-dark small fw-semibold">Supplier Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control rounded-3" id="update-Name" name="Name" placeholder="e.g. Md Rahman" required>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <label for="update-CurrentBalance" class="form-label text-dark small fw-semibold">Current Balance (BDT)</label>
                                <input type="number" step="0.01" class="form-control rounded-3" id="update-CurrentBalance" name="CurrentBalance" placeholder="e.g. 0.00">
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Contact & Identification -->
                    <div class="mb-4 pb-3 border-bottom">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-card-heading"></i> Contact & Identification
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6 col-lg-4">
                                <label for="update-Mobile" class="form-label text-dark small fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                                <input type="tel" class="form-control rounded-3" id="update-Mobile" name="Mobile" placeholder="e.g. 01712345678" required>
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <label for="update-Email" class="form-label text-dark small fw-semibold">Email Address</label>
                                <input type="email" class="form-control rounded-3" id="update-Email" name="Email" placeholder="e.g. supplier@example.com">
                            </div>
                            <div class="col-md-6 col-lg-4">
                                <label for="update-NidNo" class="form-label text-dark small fw-semibold">NID Number</label>
                                <input type="text" class="form-control rounded-3" id="update-NidNo" name="NidNo" placeholder="e.g. 198765432101">
                            </div>
                        </div>
                    </div>

                    <!-- Section 3: Address & Additional Details -->
                    <div class="mb-4 pb-3 border-bottom">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill"></i> Address & Remarks
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="update-PresentAddress" class="form-label text-dark small fw-semibold">Present Address</label>
                                <textarea class="form-control rounded-3" id="update-PresentAddress" name="PresentAddress" rows="2" placeholder="Enter present shop/business address..."></textarea>
                            </div>
                            <div class="col-md-6">
                                <label for="update-PermanentAddress" class="form-label text-dark small fw-semibold">Permanent Address</label>
                                <textarea class="form-control rounded-3" id="update-PermanentAddress" name="PermanentAddress" rows="2" placeholder="Enter permanent home address..."></textarea>
                            </div>
                            <div class="col-12">
                                <label for="update-AdditionalDetails" class="form-label text-dark small fw-semibold">Additional Details / Notes</label>
                                <textarea class="form-control rounded-3" id="update-AdditionalDetails" name="AdditionalDetails" rows="2" placeholder="Enter any extra notes or supplier information..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Section 4: Document & Image Uploads -->
                    <div class="mb-3">
                        <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-arrow-up-fill"></i> Document Uploads
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label for="update-Image" class="form-label text-dark small fw-semibold">Supplier Photo / Logo</label>
                                <input type="file" class="form-control rounded-3" id="update-Image" name="Image" accept="image/*">
                                <div id="update-image-preview" class="mt-2 text-muted small"></div>
                            </div>
                            <div class="col-md-4">
                                <label for="update-NidImage" class="form-label text-dark small fw-semibold">NID Document</label>
                                <input type="file" class="form-control rounded-3" id="update-NidImage" name="NidImage" accept="image/*">
                                <div id="update-nid-preview" class="mt-2 text-muted small"></div>
                            </div>
                            <div class="col-md-4">
                                <label for="update-ChequeImage" class="form-label text-dark small fw-semibold">Bank Cheque Image</label>
                                <input type="file" class="form-control rounded-3" id="update-ChequeImage" name="ChequeImage" accept="image/*">
                                <div id="update-cheque-preview" class="mt-2 text-muted small"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Footer Action Buttons -->
                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                        <button type="button" class="btn btn-light border rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="btn-update-supplier" class="btn btn-primary rounded-3 px-4 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                            <span id="btn-update-text">Update</span>
                            <div id="update-spinner" class="spinner-border spinner-border-sm d-none" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Supplier Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="deleteConfirmationModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i> Delete Supplier
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-2 text-dark">Are you sure you want to delete supplier <strong id="delete-supplier-name" class="text-danger"></strong>?</p>
                <p class="text-muted small mb-0">This action cannot be undone and will permanently remove the supplier record from the system.</p>
                
                <div id="delete-modal-error" class="alert alert-danger d-none mt-3 mb-0 rounded-3 py-2 px-3 small align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span id="delete-modal-error-text">Failed to delete supplier.</span>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light border rounded-3 px-3" data-bs-dismiss="modal" id="btn-cancel-delete">Cancel</button>
                <button type="button" class="btn btn-danger rounded-3 px-4 fw-semibold d-inline-flex align-items-center gap-2" id="btn-confirm-delete">
                    <i class="bi bi-trash-fill"></i>
                    <span id="btn-confirm-delete-text">Delete</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    <div id="app-toast" class="toast align-items-center text-white border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 py-3 px-3 fs-6">
                <i id="toast-icon" class="bi fs-5"></i>
                <span id="toast-message"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = "@apiBaseUrl";
    </script>
    <!-- jsPDF & AutoTable for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <!-- SheetJS for Excel Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="~/js/Supplier/list.js" asp-append-version="true"></script>
}
