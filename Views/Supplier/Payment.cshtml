@{
    ViewData["Title"] = "Supplier Payments";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4 flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
    <div>
        <h1 class="page-title d-flex align-items-center gap-2">
            <i class="bi bi-cash-stack text-primary"></i> Supplier Payments
        </h1>
        <p class="page-subtitle mb-0">Track and monitor supplier payments.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" id="btn-export-pdf" class="btn btn-outline-danger rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" title="Export payments to PDF">
            <i class="bi bi-file-earmark-pdf-fill fs-6 text-danger"></i>
            <span>Download PDF</span>
        </button>
        <button type="button" id="btn-export-excel" class="btn btn-outline-success rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" title="Export payments to Excel">
            <i class="bi bi-file-earmark-excel-fill fs-6 text-success"></i>
            <span>Download Excel</span>
        </button>
    </div>
</div>

<!-- Search & Filter Card (One Line) -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #ffffff;">
    <div class="card-body p-3 p-md-4">
        <form id="payment-filter-form" class="row g-2 g-md-3 align-items-end">
            <!-- Search Text -->
            <div class="col-12 col-md-4 col-xl">
                <label for="search-input" class="form-label text-muted small fw-medium mb-1">Search Term</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="search-input" class="form-control bg-light border-start-0 ps-1" placeholder="Search Trans#, Supplier, Shop, Remarks..." autocomplete="off">
                </div>
            </div>

            <!-- From Date -->
            <div class="col-6 col-sm-auto" style="min-width: 155px;">
                <label for="from-date-input" class="form-label text-muted small fw-medium mb-1">From Date</label>
                <input type="date" id="from-date-input" class="form-control bg-light">
            </div>

            <!-- To Date -->
            <div class="col-6 col-sm-auto" style="min-width: 155px;">
                <label for="to-date-input" class="form-label text-muted small fw-medium mb-1">To Date</label>
                <input type="date" id="to-date-input" class="form-control bg-light">
            </div>

            <!-- Action Buttons -->
            <div class="col-auto d-flex align-items-center gap-2">
                <button type="submit" id="btn-search" class="btn btn-primary rounded-3 px-3 fw-medium d-inline-flex align-items-center gap-2 shadow-sm" style="height: 38px;" title="Apply Filters">
                    <i class="bi bi-filter"></i>
                    <span>Apply Filters</span>
                </button>
                <button type="button" id="btn-reset" class="btn btn-outline-secondary rounded-3 px-3 fw-medium d-inline-flex align-items-center gap-2" style="height: 38px;" title="Reset all filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    <span>Reset</span>
                </button>
            </div>

            <!-- Rows per page selector -->
            <div class="col-auto d-flex align-items-center gap-2 ms-md-auto" style="height: 38px;">
                <div class="vr mx-1 d-none d-sm-block" style="height: 24px;"></div>
                <label for="page-size-select" class="form-label text-muted small mb-0 fw-medium">Rows:</label>
                <select id="page-size-select" class="form-select form-select-sm rounded-3" style="width: 75px;">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </form>

        <!-- Active Filter Badges (if any) -->
        <div class="d-flex align-items-center gap-2 mt-2" id="active-filter-badges"></div>
    </div>
</div>

<!-- Alert Box for API connection errors -->
<div id="api-error-alert" class="alert alert-danger d-none rounded-3 mb-4 shadow-sm align-items-center justify-content-between" role="alert">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <span id="api-error-message">Failed to connect to backend server.</span>
    </div>
    <button type="button" id="btn-retry-api" class="btn btn-sm btn-outline-danger rounded-2 px-3 fw-medium">
        <i class="bi bi-arrow-clockwise me-1"></i> Retry
    </button>
</div>

<!-- Payments Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: #ffffff;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 payment-list-table">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; width: 140px;">Date</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; width: 180px;">Transaction No</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; width: 230px;">Supplier</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; width: 180px;">Remarks</th>
                    <th class="text-end text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; width: 140px;">Payment</th>
                    <th class="text-center text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; width: 200px;">Balance Flow</th>
                    <th class="pe-4 text-end text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; width: 140px;">Action</th>
                </tr>
            </thead>
            <tbody id="payments-table-body">
                <!-- Loading Skeleton -->
                <tr id="payments-loading-row">
                    <td colspan="7" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="text-muted small mt-2">Fetching supplier payments...</div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Empty State Container -->
    <div id="payments-empty-state" class="text-center py-5 d-none">
        <div class="mb-3 text-muted" style="font-size: 3rem;">
            <i class="bi bi-cash-coin"></i>
        </div>
        <h5 class="fw-semibold text-dark mb-1">No Supplier Payments Found</h5>
        <p class="text-muted small mb-0">Try clearing filters, searching by a different term, or expanding your date range.</p>
        <button type="button" class="btn btn-outline-primary btn-sm rounded-3 mt-3 px-3" onclick="document.getElementById('btn-reset').click()">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Clear All Filters
        </button>
    </div>

    <!-- Table Footer / Pagination -->
    <div class="card-footer bg-white border-top-0 p-3 p-md-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
        <div id="pagination-info" class="text-muted small">
            Showing 0 to 0 of 0 entries
        </div>
        <nav aria-label="Payments List Pagination">
            <ul id="pagination-list" class="pagination pagination-sm mb-0 gap-1">
                <!-- Dynamic Pagination Buttons -->
            </ul>
        </nav>
    </div>
</div>

<!-- Payment Details Voucher Modal -->
<div class="modal fade" id="paymentDetailsModal" tabindex="-1" aria-labelledby="paymentDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="paymentDetailsModalLabel">
                    <i class="bi bi-cash-stack text-success"></i> Payment Voucher: <span id="modal-payment-trans-no" class="text-primary font-monospace"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modal-payment-details-content">
                <!-- Dynamically rendered payment voucher details -->
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Payment Modals -->
<!-- Delete Payment Confirmation Modal -->
<div class="modal fade" id="deletePaymentModal" tabindex="-1" aria-labelledby="deletePaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2" id="deletePaymentModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i> Confirm Deletion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-2 text-dark">Are you sure you want to delete supplier payment <strong id="delete-payment-ref" class="text-danger font-monospace"></strong> (ID: #<span id="delete-payment-id"></span>)?</p>
                <p class="text-muted small mb-0">This action cannot be undone and will permanently remove this payment record from the system.</p>
                <div id="delete-payment-error" class="alert alert-danger d-none mt-3 mb-0 rounded-3 py-2 px-3 small align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span id="delete-payment-error-text">Failed to delete payment.</span>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light border rounded-3 px-3" data-bs-dismiss="modal" id="btn-cancel-delete-payment">Cancel</button>
                <button type="button" class="btn btn-danger rounded-3 px-4 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" id="btn-confirm-delete-payment">
                    <i class="bi bi-trash-fill"></i>
                    <span id="btn-confirm-delete-payment-text">Delete</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Payment Modals -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    <div id="app-toast" class="toast align-items-center text-white border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 py-3 px-3 fs-6">
                <i id="toast-icon" class="bi fs-5"></i>
                <span id="toast-message"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<style>
    .transaction-ref-badge {
        font-size: 0.82rem;
        letter-spacing: 0.3px;
        transition: background-color 0.2s ease;
    }
    .transaction-ref-badge:hover {
        background-color: #e2e8f0 !important;
    }
    .balance-flow-box {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
    }
    @@media print {
        body > *:not(.modal) {
            display: none !important;
        }
        .modal {
            position: static !important;
            display: block !important;
            overflow: visible !important;
        }
        .modal-dialog {
            max-width: 100% !important;
            margin: 0 !important;
        }
        .modal-content {
            border: none !important;
            box-shadow: none !important;
        }
        .modal-footer, .btn-close, .app-sidebar, .top-navbar, .page-header-row, .card-footer, .toast-container {
            display: none !important;
        }
    }
</style>

@section Scripts {
    <script>
        const API_BASE_URL = "@apiBaseUrl";
    </script>
    <!-- jsPDF & AutoTable for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <!-- SheetJS for Excel Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Supplier Payment Client Script -->
    <script src="~/js/Supplier/payment.js" asp-append-version="true"></script>
}
