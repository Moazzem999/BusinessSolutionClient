@{
    ViewData["Title"] = "Create Product";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4 flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
    <div>
        <h1 class="page-title d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill text-primary"></i> Create New Product
        </h1>
        <p class="page-subtitle mb-0">Fill in the product information below to register a new product.</p>
    </div>
    <div>
        <a asp-controller="Product" asp-action="List" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-medium d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> Back to Product List
        </a>
    </div>
</div>

<!-- Alert Boxes -->
<div id="create-error-alert" class="alert alert-danger d-none rounded-3 mb-4 shadow-sm align-items-center gap-2" role="alert">
    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
    <span id="create-error-message">Error saving product data.</span>
</div>

<div id="create-success-alert" class="alert alert-success d-none rounded-3 mb-4 shadow-sm align-items-center gap-2" role="alert">
    <i class="bi bi-check-circle-fill fs-5"></i>
    <span id="create-success-message">Product created successfully! Redirecting...</span>
</div>

<!-- Main Create Form Card -->
<div class="card border-0 shadow-sm rounded-4 mb-5" style="background: #ffffff;">
    <div class="card-body p-4 p-md-5">
        <form id="create-product-form" enctype="multipart/form-data">
            <input type="hidden" id="Id" name="Id" value="0" />

            <!-- Basic Product Information -->
            <div class="mb-4 pb-3 border-bottom">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-box-seam text-primary"></i> Product Details
                </h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="Name" class="form-label text-dark small fw-semibold">Product Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control rounded-3" id="Name" name="Name" placeholder="e.g. Winter Hoodie" required>
                    </div>
                    <div class="col-12">
                        <label for="Details" class="form-label text-dark small fw-semibold">Details / Description</label>
                        <textarea class="form-control rounded-3" id="Details" name="Details" rows="3" placeholder="Enter product specifications, material, details..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Product Image Upload -->
            <div class="mb-4">
                <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-image text-primary"></i> Product Image
                </h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="Image" class="form-label text-dark small fw-semibold">Upload Image</label>
                        <input type="file" class="form-control rounded-3" id="Image" name="Image" accept="image/*">
                        <div class="form-text small text-muted">Upload product photo (.png, .jpg, .jpeg)</div>
                        <div id="image-preview-container" class="mt-3 d-none">
                            <div class="d-inline-flex align-items-center gap-2 p-1 border rounded-3 bg-light">
                                <img id="image-preview" src="#" alt="Preview" class="rounded-2" style="max-height: 100px; max-width: 150px; object-fit: contain;">
                                <button type="button" id="btn-remove-image" class="btn btn-sm btn-outline-danger border-0 p-1" title="Remove Image">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Submit Controls -->
            <div class="d-flex align-items-center justify-content-end gap-3 pt-3 border-top">
                <a asp-controller="Product" asp-action="List" class="btn btn-outline-secondary rounded-3 px-4 py-2">
                    Cancel
                </a>
                <button type="submit" id="btn-save-product" class="btn btn-primary rounded-3 px-5 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                    <span id="btn-save-text">Save</span>
                    <div id="save-spinner" class="spinner-border spinner-border-sm d-none" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = "@apiBaseUrl";
    </script>
    <script src="~/js/Product/create.js" asp-append-version="true"></script>
}
