@{
    ViewData["Title"] = "Product List";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4 flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
    <div>
        <h1 class="page-title d-flex align-items-center gap-2">
            <i class="bi bi-box-seam-fill text-primary"></i> Product Management
        </h1>
        <p class="page-subtitle mb-0">View, search, filter, and manage all product catalog items.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" id="btn-open-create-product" class="btn btn-primary rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#createProductModal">
            <i class="bi bi-plus-circle-fill fs-6"></i>
            <span>Create</span>
        </button>
        <button type="button" id="btn-export-pdf" class="btn btn-outline-danger rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" title="Export current list to PDF">
            <i class="bi bi-file-earmark-pdf-fill fs-6 text-danger"></i>
            <span>Download PDF</span>
        </button>
        <button type="button" id="btn-export-excel" class="btn btn-outline-success rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" title="Export current list to Excel">
            <i class="bi bi-file-earmark-excel-fill fs-6 text-success"></i>
            <span>Download Excel</span>
        </button>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #ffffff;">
    <div class="card-body p-3 p-md-4">
        <form id="product-search-form" class="row g-2 g-md-3 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="search-input" class="form-control bg-light border-start-0 ps-1" placeholder="Search by product name, details..." autocomplete="off">
                </div>
            </div>
            <div class="col-6 col-md-auto">
                <button type="submit" id="btn-search" class="btn btn-primary w-100 rounded-3 px-3 fw-medium d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-filter"></i> Search
                </button>
            </div>
            <div class="col-6 col-md-auto">
                <button type="button" id="btn-reset" class="btn btn-outline-secondary w-100 rounded-3 px-3 fw-medium d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </button>
            </div>
            <div class="col-12 col-md-auto ms-md-auto d-flex align-items-center justify-content-between justify-content-md-end gap-3 mt-2 mt-md-0 flex-wrap">
                <div class="d-flex align-items-center gap-2">
                    <label for="status-filter" class="form-label text-muted small mb-0 fw-medium">Status:</label>
                    <select id="status-filter" class="form-select form-select-sm rounded-3" style="width: 110px;">
                        <option value="" selected>All</option>
                        <option value="1">Active</option>
                        <option value="0">Inactive</option>
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="page-size-select" class="form-label text-muted small mb-0 fw-medium">Rows:</label>
                    <select id="page-size-select" class="form-select form-select-sm rounded-3" style="width: 75px;">
                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Alert Box for API connection errors -->
<div id="api-error-alert" class="alert alert-danger d-none rounded-3 mb-4 shadow-sm align-items-center justify-content-between" role="alert">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <span id="api-error-message">Failed to connect to backend server.</span>
    </div>
    <button type="button" id="btn-retry-api" class="btn btn-sm btn-outline-danger rounded-2 px-3 fw-medium">
        <i class="bi bi-arrow-clockwise me-1"></i> Retry
    </button>
</div>

<!-- Product Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: #ffffff;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 product-list-table">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; width: 80px;">#ID</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Product</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Details</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; width: 120px;">Status</th>
                    <th class="pe-4 text-end text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px; width: 135px;">Action</th>
                </tr>
            </thead>
            <tbody id="product-table-body">
                <!-- Loading Skeleton -->
                <tr id="product-loading-row">
                    <td colspan="5" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="text-muted small mt-2">Fetching products list...</div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Empty State Container -->
    <div id="product-empty-state" class="text-center py-5 d-none">
        <div class="mb-3 text-muted" style="font-size: 3rem;">
            <i class="bi bi-box-seam"></i>
        </div>
        <h5 class="fw-semibold text-dark mb-1">No Products Found</h5>
        <p class="text-muted small mb-0">Try changing your search query or adjusting your filters.</p>
    </div>

    <!-- Table Footer / Pagination -->
    <div class="card-footer bg-white border-top-0 p-3 p-md-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
        <div id="pagination-info" class="text-muted small">
            Showing 0 to 0 of 0 entries
        </div>
        <nav aria-label="Product List Pagination">
            <ul id="pagination-list" class="pagination pagination-sm mb-0 gap-1">
                <!-- Dynamic Pagination Buttons -->
            </ul>
        </nav>
    </div>
</div>

<!-- Product Details Modal -->
<div class="modal fade" id="productDetailsModal" tabindex="-1" aria-labelledby="productDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="productDetailsModalLabel">
                    <i class="bi bi-box-seam-fill text-primary"></i> Product Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modal-product-content">
                <!-- Dynamic Modal Content rendered via JavaScript -->
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Product Delete Confirmation Modal -->
<div class="modal fade" id="deleteProductModal" tabindex="-1" aria-labelledby="deleteProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="deleteProductModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i> Delete Product
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-2 text-dark">Are you sure you want to delete product <strong id="delete-product-name" class="text-danger"></strong> (ID: #<span id="delete-product-id"></span>)?</p>
                <p class="text-muted small mb-0">This action cannot be undone and will permanently remove the product from the catalog.</p>
                
                <div id="delete-product-error" class="alert alert-danger d-none mt-3 mb-0 rounded-3 py-2 px-3 small align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span id="delete-product-error-text">Failed to delete product.</span>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light border rounded-3 px-3" data-bs-dismiss="modal" id="btn-cancel-delete">Cancel</button>
                <button type="button" class="btn btn-danger rounded-3 px-4 fw-semibold d-inline-flex align-items-center gap-2" id="btn-confirm-delete">
                    <i class="bi bi-trash-fill"></i>
                    <span id="btn-confirm-delete-text">Delete</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Create Product Modal -->
<div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="createProductModalLabel">
                    <i class="bi bi-plus-circle-fill text-primary"></i> Create New Product
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Alert box for errors -->
                <div id="create-product-error" class="alert alert-danger d-none rounded-3 mb-3 shadow-sm align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span id="create-product-error-text">Failed to create product.</span>
                </div>

                <form id="create-product-form" enctype="multipart/form-data">
                    <input type="hidden" id="create-product-id" name="Id" value="0" />

                    <div class="mb-3">
                        <label for="create-product-name" class="form-label text-dark small fw-semibold">Product Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control rounded-3" id="create-product-name" name="Name" placeholder="e.g. Winter Hoodie" required>
                    </div>

                    <div class="mb-3">
                        <label for="create-product-details" class="form-label text-dark small fw-semibold">Details / Description</label>
                        <textarea class="form-control rounded-3" id="create-product-details" name="Details" rows="3" placeholder="Enter product specifications, material, description..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="create-product-image" class="form-label text-dark small fw-semibold">Product Image</label>
                        <input type="file" class="form-control rounded-3" id="create-product-image" name="Image" accept="image/*">
                        <div id="create-image-preview-container" class="mt-2 d-none">
                            <div class="d-inline-flex align-items-center gap-2 p-1 border rounded-3 bg-light">
                                <img id="create-image-preview" src="#" alt="Preview" class="rounded-2" style="max-height: 80px; max-width: 120px; object-fit: contain;">
                                <button type="button" id="btn-remove-create-image" class="btn btn-sm btn-outline-danger border-0 p-1" title="Remove Image">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top mt-4">
                        <button type="button" class="btn btn-light border rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="btn-submit-create" class="btn btn-primary rounded-3 px-4 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                            <span id="btn-submit-create-text">Create Product</span>
                            <div id="create-spinner" class="spinner-border spinner-border-sm d-none" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Update Product Modal -->
<div class="modal fade" id="updateProductModal" tabindex="-1" aria-labelledby="updateProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="updateProductModalLabel">
                    <i class="bi bi-pencil-square text-primary"></i> Edit Product
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Alert box for errors -->
                <div id="update-product-error" class="alert alert-danger d-none rounded-3 mb-3 shadow-sm align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span id="update-product-error-text">Failed to update product.</span>
                </div>

                <form id="update-product-form" enctype="multipart/form-data">
                    <input type="hidden" id="update-product-id" name="Id" />

                    <div class="mb-3">
                        <label for="update-product-name" class="form-label text-dark small fw-semibold">Product Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control rounded-3" id="update-product-name" name="Name" placeholder="e.g. Winter Hoodie" required>
                    </div>

                    <div class="mb-3">
                        <label for="update-product-details" class="form-label text-dark small fw-semibold">Details / Description</label>
                        <textarea class="form-control rounded-3" id="update-product-details" name="Details" rows="3" placeholder="Enter product specifications, material, description..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="update-product-image" class="form-label text-dark small fw-semibold">Product Image</label>
                        <input type="file" class="form-control rounded-3" id="update-product-image" name="Image" accept="image/*">
                        <div class="form-text small text-muted">Leave empty to keep existing image, or choose a new file to replace it.</div>
                        <div id="update-image-preview-container" class="mt-2 d-none">
                            <div class="d-inline-flex align-items-center gap-2 p-1 border rounded-3 bg-light">
                                <img id="update-image-preview" src="#" alt="Preview" class="rounded-2" style="max-height: 80px; max-width: 120px; object-fit: contain;">
                                <span class="text-muted small ps-1" id="update-image-status"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top mt-4">
                        <button type="button" class="btn btn-light border rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="btn-submit-update" class="btn btn-primary rounded-3 px-4 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                            <span id="btn-submit-update-text">Update</span>
                            <div id="update-spinner" class="spinner-border spinner-border-sm d-none" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    <div id="app-toast" class="toast align-items-center text-white border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 py-3 px-3 fs-6">
                <i id="toast-icon" class="bi fs-5"></i>
                <span id="toast-message"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = "@apiBaseUrl";
    </script>
    <!-- jsPDF & AutoTable for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <!-- SheetJS for Excel Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="~/js/Product/list.js" asp-append-version="true"></script>
}
