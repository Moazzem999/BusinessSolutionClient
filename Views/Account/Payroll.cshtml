@{
    ViewData["Title"] = "Employee Salaries & Payroll";
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!-- Page Header Row -->
<div class="page-header-row mb-4 flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
    <div>
        <h1 class="page-title">Employee Salaries / Payroll</h1>
        <p class="page-subtitle mb-0">View, create, and manage monthly employee salary records and payslips.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button type="button" id="btn-open-create-modal" class="btn btn-primary rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#createSalaryModal">
            <i class="bi bi-plus-circle-fill fs-6"></i>
            <span>Create</span>
        </button>
        <button type="button" id="btn-export-pdf" class="btn btn-outline-danger rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-file-earmark-pdf-fill fs-6 text-danger"></i>
            <span>Download PDF</span>
        </button>
        <button type="button" id="btn-export-excel" class="btn btn-outline-success rounded-3 px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-file-earmark-excel-fill fs-6 text-success"></i>
            <span>Download Excel</span>
        </button>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: #ffffff;">
    <div class="card-body p-3 p-md-4">
        <form id="salary-search-form" class="row g-2 g-md-3 align-items-end">
            <!-- Search Text -->
            <div class="col-12 col-md-9">
                <label for="search-input" class="form-label text-muted small fw-medium mb-1">Search Term</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" id="search-input" class="form-control bg-light border-start-0 ps-1" placeholder="Search by employee name, month, remarks..." autocomplete="off">
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" id="btn-search" class="btn btn-primary flex-fill rounded-3 px-3 fw-medium d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-filter"></i> Search
                </button>
                <button type="button" id="btn-reset" class="btn btn-outline-secondary rounded-3 px-3 fw-medium d-inline-flex align-items-center justify-content-center" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>

            <!-- Page Size Selector -->
            <div class="col-12 d-flex align-items-center justify-content-end gap-2 mt-2 pt-2 border-top">
                <label for="page-size-select" class="form-label text-muted small mb-0 fw-medium">Rows per page:</label>
                <select id="page-size-select" class="form-select form-select-sm rounded-3" style="width: 75px;">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
            </div>
        </form>
    </div>
</div>

<!-- Alert Box for API connection errors -->
<div id="api-error-alert" class="alert alert-danger d-none rounded-3 mb-4 shadow-sm align-items-center gap-2" role="alert">
    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
    <span id="api-error-message">Failed to connect to backend server.</span>
</div>

<!-- Salary Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: #ffffff;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 salary-table">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Employee</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Month</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Salary</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Advance</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Bonus</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Others</th>
                    <th class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Net Total</th>
                    <th class="pe-4 text-end text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Action</th>
                </tr>
            </thead>
            <tbody id="salary-table-body">
                <!-- Loading Skeleton -->
                <tr id="salary-loading-row">
                    <td colspan="8" class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <div class="text-muted small mt-2">Fetching employee salary records...</div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Empty State Container -->
    <div id="salary-empty-state" class="text-center py-5 d-none">
        <div class="mb-3 text-muted" style="font-size: 3rem;">
            <i class="bi bi-currency-dollar"></i>
        </div>
        <h5 class="fw-semibold text-dark mb-1">No Salary Records Found</h5>
        <p class="text-muted small mb-0">Try adjusting your search filters or click "Create Salary" to add a new record.</p>
    </div>

    <!-- Table Footer / Pagination -->
    <div class="card-footer bg-white border-top-0 p-3 p-md-4 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
        <div id="pagination-info" class="text-muted small">
            Showing 0 to 0 of 0 entries
        </div>
        <nav aria-label="Salary List Pagination">
            <ul id="pagination-list" class="pagination pagination-sm mb-0 gap-1">
                <!-- Dynamic Pagination Buttons -->
            </ul>
        </nav>
    </div>
</div>

<!-- Create Salary Modal -->
<div class="modal fade" id="createSalaryModal" tabindex="-1" aria-labelledby="createSalaryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="createSalaryModalLabel">
                    <i class="bi bi-plus-circle-fill text-primary"></i> Create Salary Record
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Alert Box inside modal for API errors -->
                <div id="create-modal-error" class="alert alert-danger d-none rounded-3 mb-4 shadow-sm align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span id="create-modal-error-text">Failed to create salary record.</span>
                </div>

                <form id="create-salary-form">
                    <div class="row g-3">
                        <!-- Employee Searchable Combobox -->
                        <div class="col-md-6 position-relative" id="create-employee-search-container">
                            <label for="create-employee-search-input" class="form-label text-dark small fw-semibold">Employee <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                                    <i class="bi bi-person-search"></i>
                                </span>
                                <input type="text" id="create-employee-search-input" class="form-control bg-light border-start-0 ps-1" placeholder="Type employee name (min 3 chars to search)..." autocomplete="off" required>
                                <input type="hidden" id="create-employee-id" name="employeeId">
                                <button type="button" id="create-btn-clear-employee" class="btn btn-light border border-start-0 text-muted d-none" title="Clear Employee Selection">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            </div>
                            <!-- Autocomplete Suggestions -->
                            <div id="create-employee-suggestions-menu" class="position-absolute start-0 w-100 shadow-lg border border-secondary-subtle rounded-3 p-0 mt-1 overflow-auto bg-white d-none" style="max-height: 250px; z-index: 1060; top: 100%;">
                                <div id="create-employee-suggestions-list" class="list-group list-group-flush small"></div>
                            </div>
                        </div>

                        <!-- Pay Slip For -->
                        <div class="col-md-6">
                            <label for="create-pay-slip-for" class="form-label text-dark small fw-semibold">Pay Slip For <span class="text-danger">*</span></label>
                            <input type="month" class="form-control rounded-3 bg-light" id="create-pay-slip-for" name="paySlipFor" required>
                        </div>

                        <!-- Salary -->
                        <div class="col-md-6">
                            <label for="create-salary" class="form-label text-dark small fw-semibold">Basic Salary (BDT) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted fw-bold">৳</span>
                                <input type="number" step="0.01" min="0" class="form-control calc-trigger bg-light" id="create-salary" name="salary" placeholder="Auto-filled on employee selection" readonly tabindex="-1" style="pointer-events: none; user-select: none;" required>
                            </div>
                        </div>

                        <!-- Advance Payment -->
                        <div class="col-md-6">
                            <label for="create-advance-payment" class="form-label text-dark small fw-semibold">Advance Payment (BDT)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted fw-bold">৳</span>
                                <input type="number" step="0.01" min="0" class="form-control calc-trigger" id="create-advance-payment" name="advancePayment" placeholder="e.g. 5000" value="0">
                            </div>
                        </div>

                        <!-- Bonus Payment -->
                        <div class="col-md-6">
                            <label for="create-bonus-payment" class="form-label text-dark small fw-semibold">Bonus Payment (BDT)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted fw-bold">৳</span>
                                <input type="number" step="0.01" min="0" class="form-control calc-trigger" id="create-bonus-payment" name="bonusPayment" placeholder="e.g. 2000" value="0">
                            </div>
                        </div>

                        <!-- Others Bill -->
                        <div class="col-md-6">
                            <label for="create-others-bill" class="form-label text-dark small fw-semibold">Others Bill / Allowances (BDT)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted fw-bold">৳</span>
                                <input type="number" step="0.01" min="0" class="form-control calc-trigger" id="create-others-bill" name="othersBill" placeholder="e.g. 500" value="0">
                            </div>
                        </div>

                        <!-- Total (Calculated) -->
                        <div class="col-12">
                            <div class="p-3 rounded-3 bg-light border d-flex align-items-center justify-content-between">
                                <span class="fw-bold text-dark fs-6">Net Total Salary:</span>
                                <span class="fw-extrabold text-primary fs-4" id="create-total-display">৳ 0.00</span>
                                <input type="hidden" id="create-total" name="total" value="0">
                            </div>
                        </div>

                        <!-- Remarks -->
                        <div class="col-12">
                            <label for="create-remarks" class="form-label text-dark small fw-semibold">Remarks / Notes</label>
                            <textarea class="form-control rounded-3" id="create-remarks" name="remarks" rows="2" placeholder="e.g. Regular monthly payroll payment..."></textarea>
                        </div>
                    </div>

                    <!-- Modal Footer Buttons -->
                    <div class="d-flex align-items-center justify-content-end gap-2 pt-4 mt-3 border-top">
                        <button type="button" class="btn btn-light border rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="btn-save-salary" class="btn btn-primary rounded-3 px-4 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                            <span id="btn-save-text">Save</span>
                            <div id="save-spinner" class="spinner-border spinner-border-sm d-none" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Update Salary Modal -->
<div class="modal fade" id="updateSalaryModal" tabindex="-1" aria-labelledby="updateSalaryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="updateSalaryModalLabel">
                    <i class="bi bi-pencil-square text-warning"></i> Edit Salary Record
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Alert Box inside modal for API errors -->
                <div id="update-modal-error" class="alert alert-danger d-none rounded-3 mb-4 shadow-sm align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span id="update-modal-error-text">Failed to update salary record.</span>
                </div>

                <form id="update-salary-form">
                    <input type="hidden" id="update-id" name="id" />

                    <div class="row g-3">
                        <!-- Employee Searchable Combobox -->
                        <div class="col-md-6 position-relative" id="update-employee-search-container">
                            <label for="update-employee-search-input" class="form-label text-dark small fw-semibold">Employee <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted ps-3">
                                    <i class="bi bi-person-search"></i>
                                </span>
                                <input type="text" id="update-employee-search-input" class="form-control bg-light border-start-0 ps-1" placeholder="Type employee name (min 3 chars to search)..." autocomplete="off" required>
                                <input type="hidden" id="update-employee-id" name="employeeId">
                                <button type="button" id="update-btn-clear-employee" class="btn btn-light border border-start-0 text-muted d-none" title="Clear Employee Selection">
                                    <i class="bi bi-x-circle-fill"></i>
                                </button>
                            </div>
                            <!-- Autocomplete Suggestions -->
                            <div id="update-employee-suggestions-menu" class="position-absolute start-0 w-100 shadow-lg border border-secondary-subtle rounded-3 p-0 mt-1 overflow-auto bg-white d-none" style="max-height: 250px; z-index: 1060; top: 100%;">
                                <div id="update-employee-suggestions-list" class="list-group list-group-flush small"></div>
                            </div>
                        </div>

                        <!-- Pay Slip For -->
                        <div class="col-md-6">
                            <label for="update-pay-slip-for" class="form-label text-dark small fw-semibold">Pay Slip For <span class="text-danger">*</span></label>
                            <input type="month" class="form-control rounded-3 bg-light" id="update-pay-slip-for" name="paySlipFor" required>
                        </div>

                        <!-- Salary -->
                        <div class="col-md-6">
                            <label for="update-salary" class="form-label text-dark small fw-semibold">Basic Salary (BDT) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted fw-bold">৳</span>
                                <input type="number" step="0.01" min="0" class="form-control calc-trigger-update bg-light" id="update-salary" name="salary" placeholder="Auto-filled on employee selection" readonly tabindex="-1" style="pointer-events: none; user-select: none;" required>
                            </div>
                        </div>

                        <!-- Advance Payment -->
                        <div class="col-md-6">
                            <label for="update-advance-payment" class="form-label text-dark small fw-semibold">Advance Payment (BDT)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted fw-bold">৳</span>
                                <input type="number" step="0.01" min="0" class="form-control calc-trigger-update" id="update-advance-payment" name="advancePayment" placeholder="e.g. 5000">
                            </div>
                        </div>

                        <!-- Bonus Payment -->
                        <div class="col-md-6">
                            <label for="update-bonus-payment" class="form-label text-dark small fw-semibold">Bonus Payment (BDT)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted fw-bold">৳</span>
                                <input type="number" step="0.01" min="0" class="form-control calc-trigger-update" id="update-bonus-payment" name="bonusPayment" placeholder="e.g. 2000">
                            </div>
                        </div>

                        <!-- Others Bill -->
                        <div class="col-md-6">
                            <label for="update-others-bill" class="form-label text-dark small fw-semibold">Others Bill / Allowances (BDT)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted fw-bold">৳</span>
                                <input type="number" step="0.01" min="0" class="form-control calc-trigger-update" id="update-others-bill" name="othersBill" placeholder="e.g. 500">
                            </div>
                        </div>

                        <!-- Total (Calculated) -->
                        <div class="col-12">
                            <div class="p-3 rounded-3 bg-light border d-flex align-items-center justify-content-between">
                                <span class="fw-bold text-dark fs-6">Net Total Salary:</span>
                                <span class="fw-extrabold text-primary fs-4" id="update-total-display">৳ 0.00</span>
                                <input type="hidden" id="update-total" name="total" value="0">
                            </div>
                        </div>

                        <!-- Remarks -->
                        <div class="col-12">
                            <label for="update-remarks" class="form-label text-dark small fw-semibold">Remarks / Notes</label>
                            <textarea class="form-control rounded-3" id="update-remarks" name="remarks" rows="2" placeholder="e.g. Regular monthly payroll payment..."></textarea>
                        </div>
                    </div>

                    <!-- Modal Footer Buttons -->
                    <div class="d-flex align-items-center justify-content-end gap-2 pt-4 mt-3 border-top">
                        <button type="button" class="btn btn-light border rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" id="btn-update-salary" class="btn btn-primary rounded-3 px-4 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                            <span id="btn-update-text">Update</span>
                            <div id="update-spinner" class="spinner-border spinner-border-sm d-none" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="salaryDetailsModal" tabindex="-1" aria-labelledby="salaryDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="salaryDetailsModalLabel">
                    <i class="bi bi-file-text-fill text-primary"></i> Salary Payslip Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modal-salary-content">
                <!-- Dynamic Modal Content -->
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="deleteConfirmationModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i> Delete Salary Record
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-2 text-dark">Are you sure you want to delete this salary record for <strong id="delete-employee-name" class="text-danger"></strong> (<span id="delete-pay-slip-for"></span>)?</p>
                <p class="text-muted small mb-0">This action cannot be undone and will permanently remove the record from the system.</p>
                
                <div id="delete-modal-error" class="alert alert-danger d-none mt-3 mb-0 rounded-3 py-2 px-3 small align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span id="delete-modal-error-text">Failed to delete salary record.</span>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-light border rounded-3 px-3" data-bs-dismiss="modal" id="btn-cancel-delete">Cancel</button>
                <button type="button" class="btn btn-danger rounded-3 px-4 fw-semibold d-inline-flex align-items-center gap-2" id="btn-confirm-delete">
                    <i class="bi bi-trash-fill"></i>
                    <span id="btn-confirm-delete-text">Delete</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification Container -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
    <div id="app-toast" class="toast align-items-center text-white border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 py-3 px-3 fs-6">
                <i id="toast-icon" class="bi fs-5"></i>
                <span id="toast-message"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = "@apiBaseUrl";
    </script>
    <!-- jsPDF & AutoTable for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <!-- SheetJS for Excel Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="~/js/Account/payroll.js" asp-append-version="true"></script>
}
