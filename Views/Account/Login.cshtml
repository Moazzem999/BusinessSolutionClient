@{
    Layout = null;
    var apiBaseUrl = ViewBag.ApiBaseUrl ?? "https://localhost:7148/api";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Business Solution (HRSync)</title>
    <!-- Latest Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">

    <div class="login-card">
        <div class="login-brand">
            <div class="login-logo-box">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="login-title">
                <span style="color: #2563eb;">Business</span> Solution
            </h1>
            <p class="login-subtitle">Sign in to Business Solution API Portal</p>
        </div>

        <form id="login-form">
            <div id="login-error-alert" class="alert alert-danger d-none py-2 px-3 small rounded-3 mb-3" role="alert"></div>
            <div id="login-success-alert" class="alert alert-success d-none py-2 px-3 small rounded-3 mb-3" role="alert"></div>

            <div class="mb-3">
                <label for="username" class="form-label text-dark small fw-semibold">Username <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control bg-light border-start-0 ps-0" id="username" required autocomplete="username" placeholder="Enter username">
                </div>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label text-dark small fw-semibold">Password <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control bg-light border-start-0 ps-0" id="password" required autocomplete="current-password" placeholder="Enter password">
                </div>
            </div>

            <button type="submit" id="btn-login" class="btn btn-primary w-100 py-2 rounded-3 fw-bold d-flex align-items-center justify-content-center gap-2">
                <span id="btn-login-text">Sign In</span>
                <div id="login-spinner" class="spinner-border spinner-border-sm d-none" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </button>
        </form>
    </div>

    <script>
        const API_BASE_URL = "@apiBaseUrl";
    </script>
    <!-- Latest Bootstrap 5.3 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Auth/login.js" asp-append-version="true"></script>
</body>
</html>
